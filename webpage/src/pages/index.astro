---
import logoImage from "../assets/favicon.png";
import ArchitectureComparison from "../components/ArchitectureComparison.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const year = new Date().getFullYear();
---

<BaseLayout title="Ignition Tofu Provider · Ignition configuration as code" description="A Terraform and OpenTofu provider for Ignition that manages projects, connections and gateway settings through its REST API.">
  <Hero 
    tagline="A Terraform and OpenTofu provider for Ignition that manages projects, connections and gateway settings through its REST API."
    logo={logoImage}
  />
  
  <FeatureGrid />
  
  <ArchitectureComparison />
  
  <footer class="custom-footer">
    <div class="footer-content">
      <p>© {year} Apollogeddon. Released under the MIT License.</p>
      <p>Ignition is a trademark of Inductive Automation.</p>
    </div>
  </footer>
</BaseLayout>
